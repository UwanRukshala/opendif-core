# Consent Engine Environment Variables Template
# Copy this file to .env and update with your actual values
# =============================================================================
# Service Configuration
# =============================================================================
PORT=8081
HOST=0.0.0.0
ENVIRONMENT=local
CONSENT_PORTAL_URL=
# Add Comma Separated, (CONSENT_PORTAL_URL will be auto added)
CORS_ALLOWED_ORIGINS=

# =============================================================================
# Database Configuration
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=consent_engine
DB_SSLMODE=require

# Auto-create tables on startup (true|false)
RUN_MIGRATION=false

# =============================================================================
# Migration Configuration
# =============================================================================
RUN_MIGRATION=false

# =============================================================================
# IDP Configuration
# =============================================================================
# The verifier validates issuer, audience, and client_id when each is set,
# extracts the email claim, and is otherwise IdP-agnostic (no organization claim).
IDP_CLIENT_ID=
IDP_ISSUER=
# Access-token audience claim (ESIGNET_AUD_URL / SLUDI gateway)
IDP_AUDIENCE=
IDP_JWKS_URL=
# eSignet token endpoint for authorization-code exchange (private_key_jwt)
IDP_TOKEN_ENDPOINT=
# eSignet UI base URL used to build the /authorize redirect
IDP_ESIGNET_BASE_URL=
# OAuth redirect URI registered with eSignet (backend callback)
IDP_CALLBACK_URL=
# OIDC scopes requested during login
IDP_SCOPE=openid profile email
# RSA private key PEM registered with eSignet for client private_key_jwt auth
IDP_PRIVATE_KEY=
# Path to RSA private key PEM file (preferred over IDP_PRIVATE_KEY)
IDP_PRIVATE_KEY_FILE=
# Dev-only: skip TLS verification on the JWKS fetch (e.g. a self-signed local
# IdP). Leave false in production.
IDP_JWKS_INSECURE_SKIP_VERIFY=false
